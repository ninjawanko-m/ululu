# Sora 用 OpenAI API キー
# 設定方法（どちらかでOK、.env を手で編集する必要はありません）:
#   1) npm run start:sora 実行時にターミナルで「キーを貼り付けて Enter」
#   2) 起動後ブラウザで http://localhost:3001/setup を開いて入力
# 取得: https://platform.openai.com/api-keys （Sora は組織の承認が必要な場合あり）
OPENAI_API_KEY=

# Replicate API Token（無料モード用）
# 取得: https://replicate.com/account/api-tokens （無料枠：月$5まで、約200-500本生成可能）
# 設定すると無料モードでAI動画生成が可能になります（未設定の場合はデモモード）
REPLICATE_API_TOKEN=

# 任意: サーバーポート（既定値 3001）
# PORT=3001
